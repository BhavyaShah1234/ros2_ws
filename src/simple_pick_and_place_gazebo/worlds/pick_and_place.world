            </box>
          </geometry>
          <material>
            <ambient>0.8 0.0 0.0 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
        
        <collision name="wall_left">
          <pose>0 0.095 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 0.01 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_left">
          <pose>0 0.095 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 0.01 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.0 0.0 1</ambient>
