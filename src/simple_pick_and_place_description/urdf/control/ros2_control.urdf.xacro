<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:macro name="pick_and_place_ros2_control" params="arm_prefix robot_type use_fake_hardware">
    
    <ros2_control name="pick_and_place_system" type="system">
      
      <hardware>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_fake_hardware}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:unless>
      </hardware>
      
      <!-- Arm joints (franka_robot creates joints with robot_type prefix like fr3_joint1) -->
      <joint name="${arm_prefix}${robot_type}_joint1">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      
      <joint name="${arm_prefix}${robot_type}_joint2">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      
      <joint name="${arm_prefix}${robot_type}_joint3">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      
      <joint name="${arm_prefix}${robot_type}_joint4">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      
      <joint name="${arm_prefix}${robot_type}_joint5">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      
      <joint name="${arm_prefix}${robot_type}_joint6">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      
      <joint name="${arm_prefix}${robot_type}_joint7">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      
      <!-- Gripper finger joints -->
      <joint name="${arm_prefix}${robot_type}_finger_joint1">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.04</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      
      <joint name="${arm_prefix}${robot_type}_finger_joint2">
        <param name="mimic">${robot_type}_finger_joint1</param>
        <param name="multiplier">1.0</param>
        <state_interface name="position">
          <param name="initial_value">0.04</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
      
    </ros2_control>
    
  </xacro:macro>
  
</robot>
