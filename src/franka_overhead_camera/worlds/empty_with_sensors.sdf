<?xml version="1.0" ?>
<!--
  Same as the stock ros_gz_sim "empty.sdf" world, with one addition: the
  gz::sim::systems::Sensors system plugin. Without it, camera/depth/lidar
  sensors (including the overhead RGB-D camera from franka_overhead_camera)
  advertise their topics but never actually render or publish frames: the
  system that drives sensor rendering simply isn't loaded in the plain
  empty.sdf world used by franka_gazebo_bringup's example launch files.
-->
<sdf version="1.6">
  <world name="empty">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Flat, distinctly colored markers on the floor for calibrating the
      overhead camera's position/orientation: with the robot in its default
      pose, compare where these known (x, y) ground-truth points land in
      /overhead_camera/image against where they should land given the
      camera's height/tilt, and adjust the -x/-y/-z/-R/-P/-Y spawn arguments
      in franka_with_overhead_camera.launch.py accordingly.

      Placed at 3 of the 4 corners of a 1 m x 1 m square, all in front of the
      robot (the robot is spawned at the world origin with no rotation, so
      "in front" is +X; the 4th corner, at (1.3, -0.5), is left empty):
      blue (0.3, 0.5), green (0.3, -0.5), yellow (1.3, 0.5). Note these fall
      outside the overhead camera's default ground footprint unless its
      -x spawn argument and/or height/horizontal_fov are adjusted to bring
      this region into view: see franka_with_overhead_camera.launch.py.
    -->
    <model name="calibration_marker_blue">
      <static>true</static>
      <pose>0.3 0.5 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.9 1</ambient>
            <diffuse>0.1 0.1 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="calibration_marker_green">
      <static>true</static>
      <pose>0.3 -0.5 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.1 1</ambient>
            <diffuse>0.1 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="calibration_marker_yellow">
      <static>true</static>
      <pose>1.3 0.5 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.1 1</ambient>
            <diffuse>0.9 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
