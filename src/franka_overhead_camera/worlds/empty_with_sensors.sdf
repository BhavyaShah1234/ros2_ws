<?xml version="1.0" ?>
<!--
  Same as the stock ros_gz_sim "empty.sdf" world, with one addition: the
  gz::sim::systems::Sensors system plugin. Without it, camera/depth/lidar
  sensors (including the overhead RGB-D camera from franka_overhead_camera)
  advertise their topics but never actually render or publish frames: the
  system that drives sensor rendering simply isn't loaded in the plain
  empty.sdf world used by franka_gazebo_bringup's example launch files.
-->
<sdf version="1.6">
  <world name="empty">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Flat, distinctly colored markers on the floor for calibrating the
      overhead camera's position/orientation: with the robot in its default
      pose, compare where these known (x, y) ground-truth points land in
      /overhead_camera/image against where they should land given the
      camera's height/tilt, and adjust the -x/-y/-z/-R/-P/-Y spawn arguments
      in franka_with_overhead_camera.launch.py accordingly.

      Placed at 3 of the 4 corners of a 1 m x 1 m square centered on the
      robot base (the 4th corner, at (-0.5, -0.5), is left empty): blue
      (0.5, 0.5), green (-0.5, 0.5), yellow (0.5, -0.5). Note this square's
      corners (up to ~0.71 m from center) fall outside the overhead camera's
      current ~0.92 m x 0.69 m ground footprint at its default 0.797 m
      height and 60 degree horizontal FOV: raise the camera and/or widen
      horizontal_fov in models/overhead_camera/model.sdf if you need all
      three markers in frame at once.
    -->
    <model name="calibration_marker_blue">
      <static>true</static>
      <pose>0.5 0.5 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.9 1</ambient>
            <diffuse>0.1 0.1 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="calibration_marker_green">
      <static>true</static>
      <pose>-0.5 0.5 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.1 1</ambient>
            <diffuse>0.1 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="calibration_marker_yellow">
      <static>true</static>
      <pose>0.5 -0.5 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.1 1</ambient>
            <diffuse>0.9 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.04</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
