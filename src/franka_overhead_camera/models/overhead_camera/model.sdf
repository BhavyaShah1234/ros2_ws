<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="overhead_camera">
    <!--
      Fixed overhead camera, meant to be centered above the robot base (world
      origin) and pitched 90 degrees so its optical axis (local +X) points
      straight down the world -Z axis at the floor.

      No <pose> here: this model is always spawned via `ros_gz_sim create`
      (see franka_with_overhead_camera.launch.py), whose -x/-y/-z/-R/-P/-Y
      arguments unconditionally override any pose set here, even when left
      at their default of 0: verified empirically by spawning this file
      with no pose flags and observing it land at the origin with identity
      orientation. The actual mount pose, and the FR3-forward-kinematics
      derivation of its height, live in that launch file instead.
    -->
    <static>true</static>

    <link name="link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.06 0.06 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <sensor name="overhead_rgbd_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>10</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>overhead_camera</topic>
      </sensor>
    </link>
  </model>
</sdf>
